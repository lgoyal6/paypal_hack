{
  "name": "paydrill",
  "version": "0.0.1",
  "description": "Real PayPal sandbox events on localhost, plus an AI drill of your webhook handler",
  "type": "module",
  "bin": {
    "paydrill": "bin/paydrill.js"
  },
  "files": [
    "bin",
    "dist",
    "src/migrate/template"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test 'src/**/*.test.ts'"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "playwright-core": "1.64.1",
    "typescript": "^5.9.3",
    "zod": "4.6.7"
  }
}
