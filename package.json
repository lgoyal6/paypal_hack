{
  "name": "paydrill",
  "version": "0.0.1",
  "description": "Real PayPal sandbox events on localhost, plus an AI drill of your webhook handler",
  "type": "module",
  "bin": {
    "paydrill": "bin/paydrill.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\" \"test/**/*.test.tsx\""
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1"
  }
}
