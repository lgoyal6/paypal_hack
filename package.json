{
  "name": "paydrill",
  "version": "0.0.1",
  "description": "Real PayPal sandbox events on localhost, plus an AI drill of your webhook handler",
  "type": "module",
  "bin": {
    "paydrill": "bin/paydrill.js"
  },
  "files": [
    "bin",
    "dist",
    "src/migrate/template"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\" \"test/**/*.test.tsx\" \"src/**/*.test.ts\""
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@clack/prompts": "^1.9.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ink": "^8.0.0",
    "playwright-core": "1.64.1",
    "react": "^19.3.1",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  }
}
